{
  "name": "mimix-cuy",
  "version": "1.0.0",
  "private": true,
  "description": "Minijuego de un cuy para el evento Mimix: cámara o teclado, obstáculos y monedas.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-assets.mjs && vite --host 127.0.0.1",
    "build": "node scripts/prepare-assets.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node scripts/prepare-assets.mjs && node --test test/*.test.js && vitest run",
    "typecheck:backend": "tsc --noEmit -p convex/tsconfig.json",
    "check:repo": "node scripts/check-repo.mjs",
    "check": "pnpm check:repo && pnpm typecheck:backend && pnpm test && pnpm build"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.14",
    "convex": "1.46.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.167.1"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "convex-test": "0.0.62",
    "esbuild": "0.21.5",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vitest": "3.2.4"
  },
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22"
  }
}
