{
  "name": "mimix-cuy",
  "version": "1.0.0",
  "private": true,
  "description": "Minijuego de un cuy para el evento Mimix: cámara o teclado, obstáculos y monedas.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-assets.mjs && vite --host 127.0.0.1",
    "build": "node scripts/prepare-assets.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node scripts/prepare-assets.mjs && node --test test/*.test.js",
    "check:repo": "node scripts/check-repo.mjs",
    "check": "pnpm check:repo && pnpm test && pnpm build"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.167.1"
  },
  "devDependencies": {
    "vite": "5.4.21"
  },
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22"
  }
}
